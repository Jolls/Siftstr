# Copy to .env and adjust. Never commit .env.
SIFTSTR_LISTEN=:8080
SIFTSTR_DATA_DIR=/data
# Public https:// URL (drives the Secure cookie flag and absolute links)
SIFTSTR_BASE_URL=
# Leave empty to auto-generate /data/secret.key
SIFTSTR_SECRET_KEY=
SIFTSTR_ADMIN_USER=
SIFTSTR_ADMIN_PASSWORD=
TZ=UTC
