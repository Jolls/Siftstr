# Copy to .env and adjust. Never commit .env.
SIFTSTR_LISTEN=:8080
SIFTSTR_DATA_DIR=/data
# URL the Claude task and browsers use to reach Siftstr, e.g. http://192.168.1.20:8080
# or https://siftstr.example.com. Drives absolute links; Secure cookies only if https://
SIFTSTR_BASE_URL=
# Leave empty to auto-generate /data/secret.key
SIFTSTR_SECRET_KEY=
SIFTSTR_ADMIN_USER=
SIFTSTR_ADMIN_PASSWORD=
TZ=UTC
