# Copy to .env and adjust. Never commit .env.
SIFTSTR_LISTEN=:8080
SIFTSTR_DATA_DIR=/data
# URL the Claude task and browsers use to reach Siftstr, e.g. http://192.168.1.20:8080
# or https://siftstr.example.com. (LAN addresses need compose.yaml's 127.0.0.1 port bind changed.) Drives absolute links; Secure cookies and HSTS only if https://; a warning is logged otherwise
SIFTSTR_BASE_URL=
# Reverse proxies whose X-Forwarded-For header gives the client IP for login limits.
# Comma-separated CIDRs or IPs, e.g. 172.18.0.0/16. Empty: the connecting address is the client.
SIFTSTR_TRUSTED_PROXIES=
# Leave empty to auto-generate /data/secret.key
SIFTSTR_SECRET_KEY=
# First start only, when there are no users. The password must be at least 12 characters.
SIFTSTR_ADMIN_USER=
SIFTSTR_ADMIN_PASSWORD=
# Optional: pre-fill the admin user's connections. The URL is re-applied on every
# start; a key is saved only when the connection has none. Use *_API_KEY_FILE
# (a path, e.g. a Docker secret) instead of *_API_KEY to keep the key out of the environment.
SIFTSTR_MINIFLUX_URL=
SIFTSTR_MINIFLUX_API_KEY=
SIFTSTR_KARAKEEP_URL=
SIFTSTR_KARAKEEP_API_KEY=
SIFTSTR_METUBE_URL=
TZ=UTC
